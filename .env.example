# Required: your Mesh API key (prefix rsk_). Never commit the real .env.
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Model ids as listed by Mesh (e.g. openai/gpt-4o-mini). Free models cost $0 on Mesh; check the model list.
MESH_MODEL=openai/gpt-4o-mini
# Use a different (ideally stronger) model for verification if you like:
MESH_VERIFIER_MODEL=openai/gpt-4o-mini

# Pipeline knobs (optional)
MAX_LOOPS=2
MIN_VERIFIED_PER_SUBQ=2
PAGES_PER_SUBQ=4
DB_PATH=data/runs.db
