# ==============================================================================
# Deeptrace Environment Configuration
# ==============================================================================

# PRODUCTION PROVIDER (Mandatory for Hackathon Submission)
# All evaluations, benchmarks, and submissions route through Mesh API.
LLM_PROVIDER=mesh
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=z-ai/glm-5.3-flash
MESH_MODEL_VERIFIER=z-ai/glm-5.3-flash
# Legacy alias for verifier model:
# MESH_VERIFIER_MODEL=z-ai/glm-5.3-flash

# Provider-Specific Request Options (e.g. reasoning controls):
# LLM_EXTRA_BODY_JSON={"reasoning":{"max_tokens":0}}

# ==============================================================================
# SEARCH & GROUNDING PROVIDERS
# ==============================================================================
# Primary: Tavily Search & Page Extract (tvly-...)
TAVILY_API_KEY=tvly_your_key_here
# Optional soft monthly cap on Tavily API credits (0 = unlimited)
TAVILY_MONTHLY_CAP=0

# ==============================================================================
# CONCURRENCY & PIPELINE KNOBS
# ==============================================================================
RESEARCH_WORKERS=3
# LLM Concurrency limit: defaults to 4 for Mesh
LLM_CONCURRENCY=4
MAX_LOOPS=2
MIN_VERIFIED_PER_SUBQ=2
PAGES_PER_SUBQ=4
RESULTS_PER_QUERY=6
DB_PATH=data/runs.db
