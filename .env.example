# ==============================================================================
# Deeptrace Environment Configuration
# ==============================================================================

# PRODUCTION PROVIDER (Mandatory for Hackathon Submission)
# All final evaluations, benchmarks, and submissions MUST route through Mesh API.
LLM_PROVIDER=mesh
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4o-mini
MESH_MODEL_VERIFIER=openai/gpt-4o-mini
# Legacy alias for verifier model:
# MESH_VERIFIER_MODEL=openai/gpt-4o-mini

# ==============================================================================
# DEV-ONLY PROVIDER: OpenRouter (Local development & testing without spending Mesh credits)
# Guardrail: Requires ALLOW_DEV_PROVIDER=1 and DEPLOY_ENV != production.
# ==============================================================================
# ALLOW_DEV_PROVIDER=1
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://github.com/deeptrace
# OPENROUTER_TITLE=Deeptrace

# OpenRouter Role-Based Models (Default + Role Overrides):
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_PLANNER=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_DRAFTER=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_VERIFIER=dots-studio/dots-3-note-preview:free
# OPENROUTER_MODEL_SYNTHESIZER=nvidia/nemotron-3.5-super-vl:free

# OpenRouter Automatic Failover / Fallback Models:
# Comma-separated list of fallback model IDs tried if the primary is rate-limited:
# OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free

# Provider-Specific Request Options (e.g. OpenRouter reasoning controls):
# Example: Disable reasoning tokens or cap reasoning budget:
# LLM_EXTRA_BODY_JSON={"reasoning": {"effort": "none", "exclude": true}}
# Or with a max token budget:
# LLM_EXTRA_BODY_JSON={"reasoning": {"max_tokens": 1500}}

# ==============================================================================
# SEARCH & GROUNDING PROVIDERS
# ==============================================================================
# Primary: Tavily Search & Page Extract (tvly-...)
TAVILY_API_KEY=tvly_your_key_here
# Optional soft monthly cap on Tavily API credits (0 = unlimited)
TAVILY_MONTHLY_CAP=0

# ==============================================================================
# CONCURRENCY & PIPELINE KNOBS
# ==============================================================================
RESEARCH_WORKERS=3
# LLM Concurrency limit: defaults to 4 for Mesh, 2 for OpenRouter
LLM_CONCURRENCY=4
MAX_LOOPS=2
MIN_VERIFIED_PER_SUBQ=2
PAGES_PER_SUBQ=4
RESULTS_PER_QUERY=6
DB_PATH=data/runs.db
