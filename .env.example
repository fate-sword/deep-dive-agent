# ProofLens environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Research mesh (distributed jobs) ------------------------------------
# URL of a running mesh node. Empty = mesh disabled.
MESH_SERVICE_URL=

# --- Search provider ------------------------------------------------------
# Provider name (e.g. "none", "tavily", "serper", ...). "none" = disabled.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- Model provider -------------------------------------------------------
# Provider used by the agents (e.g. "none", "openai", ...).
MODEL_PROVIDER=none
MODEL_API_KEY=

# --- Web server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000